{
  "$schema": "https://www.schemastore.org/wrangler.json",
  "name": "mc-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "monocromatics-fotos"
    }
  ]
}