# ==========================================================
# CABECERAS HTTP (Cloudflare Pages)
# El archivo debe llamarse EXACTAMENTE _headers y estar en la raíz
# del sitio publicado. Cloudflare Pages lo aplica a todas las
# respuestas que no vengan de la caché.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# OJO: estas reglas SOLO cubren lo que sirve Pages. Las fotos viven en el
# bucket de R2 (pub-*.r2.dev) y se sirven sin estas cabeceras: alli no hay
# CSP, X-Frame-Options ni nosniff. No es explotable con imagenes, pero es
# un origen con el que no se puede contar para cabeceras de seguridad.
# Si algun dia importa, se pueden definir cabeceras propias en el bucket
# (Cloudflare R2 -> Settings -> Headers) o servirlo tras el dominio propio.
# ==========================================================

# La CSP ya NO permite 'unsafe-inline' en script-src: todo el JS va en archivos
# (js/contacto.js es lo que antes era el <script> en linea de contacto.html) y el
# JSON-LD de index.html queda cubierto por 'self' porque el navegador no lo ejecuta
# como script (los bloques de datos estructurados los lee el crawler, no el motor JS).
# style-src sigue permitiendo 'unsafe-inline' porque hay estilos de terceros
# (Leaflet, hCaptcha) que inyectan estilos en linea; se usa poco y se deja asi.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://web3forms.com https://newassets.hcaptcha.com https://js.hcaptcha.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pub-196ffc8ef6544a1a83073be29e5a331f.r2.dev https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://*.hcaptcha.com; frame-src https://newassets.hcaptcha.com https://*.hcaptcha.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# CSS y JS: caché corta + revalidación obligatoria. Los archivos se enlazan sin
# hash ni ?v=, así que si el navegador los guardara mucho tiempo podría mezclar
# versiones viejas tras un despliegue. Con esto, a la hora como mucho vuelve a
# preguntar al servidor (y Cloudflare Pages responde 304 si no cambió nada).
# PLAN (pendiente, cuando haya dominio): renombrar a css/estilo.<hash>.css al
# desplegar para poder subir max-age a 1 año sin riesgo.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Leaflet auto-hospedado: versión fija (1.9.4), se puede cachear indefinidamente.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes y tipografías: pueden cachearse mucho tiempo (no cambian de nombre).
/imagenes/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Documentos: siempre revalidar para que un cambio de contenido se vea ya.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json

# Texto plano y XML de la raiz (robots.txt, sitemap.xml...): contenido que casi
# nunca cambia pero conviene que no quede colgado en cache indefinidamente.
/*.txt
  Cache-Control: public, max-age=3600

/*.xml
  Cache-Control: public, max-age=3600